      if (typeof layer.get === 'function') {
        var t = String(layer.get('type') || '').toLowerCase();
        if (t === 'base') return true;
        var title = String(layer.get('title') || layer.get('popuplayertitle') || '').toLowerCase();
        if (/openstreetmap|osm|google|satellite|hybrid|terrain|bing|esri|carto|basemap|bản đồ nền|ban do nen|nền|map tile|xyz|wmts/i.test(title)) return true;
      }
