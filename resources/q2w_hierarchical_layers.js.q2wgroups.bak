      if (!bm._q2wGrayscaleHooked && typeof bm.on === 'function') {
        bm._q2wGrayscaleHooked = true;
        var preFn = function (evt) {
          if (grayscaleEnabled && evt && evt.context) {
            try { evt.context.save(); evt.context.filter = 'grayscale(100%) contrast(106%)'; } catch (e) {}
          }
        };
        var postFn = function (evt) {
