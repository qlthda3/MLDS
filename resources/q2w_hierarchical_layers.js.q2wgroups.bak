  }
  function updateBasemapDomClasses(allLeaves) {
    try {
      var layerDivs = document.querySelectorAll('.ol-layers > .ol-layer');
      if (layerDivs && layerDivs.length > 1 && allLeaves && layerDivs.length === allLeaves.length) {
        for (var i = 0; i < allLeaves.length; i++) {
          if (allLeaves[i]._q2wIsBasemap && grayscaleEnabled) layerDivs[i].classList.add('q2w-basemap-grayscale');
          else layerDivs[i].classList.remove('q2w-basemap-grayscale');
        }
      }
    } catch (e) {}
  }
  function setGrayscaleBasemap(enabled) {
