  var appSettings = {"enableGrayscaleControl":true,"defaultGrayscale":false,"mergeLegends":true,"enableInfoFrame":true,"hideDefaultPopupWhenFrame":false,"requirePassword":false,"passwordHash":"","passwordToken":""};
  var popupWheelZoomOnPopup = true;
  var css = "html.q2w-locked #map, html.q2w-locked .ol-control, html.q2w-locked #popup, html.q2w-locked #q2w-info-frame { visibility: hidden !important; pointer-events: none !important; }\r\nhtml.q2w-hide-native-popup #popup, html.q2w-hide-native-popup .ol-popup { display: none !important; }\r\n.q2w-basemap-grayscale { filter: grayscale(100%) contrast(106%) !important; -webkit-filter: grayscale(100%) contrast(106%) !important; }\r\n#q2w-security-gate { position: fixed; inset: 0; top: 0; left: 0; right: 0; bottom: 0; z-index: 2147483647; display: flex; align-items: center; justify-content: center; background: linear-gradient(135deg, rgba(15,23,42,0.92), rgba(30,41,59,0.96)); backdrop-filter: blur(12px); -webkit-backdrop-filter: blur(12px); font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Arial, sans-serif; padding: 16px; }\r\n.q2w-security-card { width: 100%; max-width: 390px; background: #ffffff; border-radius: 14px; padding: 28px 24px; box-shadow: 0 20px 50px rgba(0,0,0,0.4); text-align: center; color: #0f172a; }\r\n.q2w-sec-icon { width: 56px; height: 56px; margin: 0 auto 14px; border-radius: 50%; background: #eff6ff; color: #2563eb; display: flex; align-items: center; justify-content: center; }\r\n.q2w-sec-title { margin: 0 0 8px; font-size: 19px; font-weight: 700; color: #0f172a; }\r\n.q2w-sec-desc { margin: 0 0 18px; font-size: 13px; line-height: 1.45; color: #475569; }\r\n.q2w-sec-input-wrap { position: relative; display: flex; align-items: center; margin-bottom: 12px; }\r\n.q2w-sec-input { width: 100%; height: 42px; padding: 0 40px 0 14px; border: 1.5px solid #cbd5e1; border-radius: 8px; font-size: 14px; outline: none; transition: border-color .15s; }\r\n.q2w-sec-input:focus { border-color: #2563eb; box-shadow: 0 0 0 3px rgba(37,99,235,0.15); }\r\n.q2w-sec-eye { position: absolute; right: 8px; background: transparent; border: 0; cursor: pointer; font-size: 16px; padding: 4px 6px; color: #64748b; }\r\n.q2w-sec-remember { display: flex; align-items: center; justify-content: center; gap: 6px; font-size: 12.5px; color: #475569; margin-bottom: 14px; cursor: pointer; }\r\n.q2w-sec-error { background: #fef2f2; color: #dc2626; border: 1px solid #fecaca; border-radius: 6px; padding: 8px 10px; font-size: 12.5px; margin-bottom: 12px; font-weight: 500; }\r\n.q2w-sec-submit { width: 100%; height: 42px; border: 0; border-radius: 8px; background: #2563eb; color: #ffffff; font-size: 14px; font-weight: 600; cursor: pointer; transition: background .15s; }\r\n.q2w-sec-submit:hover { background: #1d4ed8; }\r\n@keyframes q2wShake { 0%,100%{transform:translateX(0);} 20%,60%{transform:translateX(-7px);} 40%,80%{transform:translateX(7px);} }\r\n.q2w-shake { animation: q2wShake 0.35s ease; }\r\n#q2w-hierarchical-switcher { display: flex; flex-direction: column; font: 13px/1.4 -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Arial, sans-serif; color: #1e293b; background: rgba(255,255,255,0.97); backdrop-filter: blur(8px); border: 1px solid #cbd5e1; border-radius: 10px; box-shadow: 0 8px 28px rgba(15,23,42,0.18); min-width: 268px; max-width: 375px; max-height: calc(100vh - 16px); max-height: calc(100dvh - 16px); overflow: hidden; box-sizing: border-box; pointer-events: auto; }\r\n#q2w-hierarchical-switcher.q2w-collapsed { min-width: 190px; }\r\n#q2w-hierarchical-switcher * { box-sizing: border-box; }\r\n#q2w-hierarchical-switcher .q2w-tree-titlebar { flex: 0 0 auto; display: flex; align-items: center; justify-content: space-between; background: linear-gradient(90deg, #0f172a, #1e3a8a); color: #ffffff; padding: 7px 10px; font-weight: 600; }\r\n#q2w-hierarchical-switcher .q2w-tree-title-wrap { display: flex; align-items: center; gap: 7px; font-size: 13px; white-space: nowrap; }\r\n#q2w-hierarchical-switcher .q2w-tree-panel-toggle { cursor: pointer; border: 1px solid rgba(255,255,255,0.28); border-radius: 6px; background: rgba(255,255,255,0.12); color: #ffffff; font-size: 15px; line-height: 18px; min-width: 26px; height: 24px; padding: 0 6px; }\r\n#q2w-hierarchical-switcher .q2w-tree-panel-toggle:hover { background: rgba(255,255,255,0.24); }\r\n#q2w-hierarchical-switcher .q2w-tree-panel-content { display: flex; flex-direction: column; flex: 1 1 auto; min-height: 0; overflow: hidden; }\r\n#q2w-hierarchical-switcher .q2w-tree-toolbar { flex: 0 0 auto; padding: 6px 8px 5px; background: #f8fafc; border-bottom: 1px solid #e2e8f0; }\r\n#q2w-hierarchical-switcher .q2w-tree-search { width: 100%; height: 27px; padding: 0 8px; border: 1px solid #cbd5e1; border-radius: 6px; font-size: 12px; outline: none; background: #ffffff; margin-bottom: 4px; }\r\n#q2w-hierarchical-switcher .q2w-tree-search:focus { border-color: #2563eb; box-shadow: 0 0 0 2px rgba(37,99,235,0.15); }\r\n#q2w-hierarchical-switcher .q2w-tree-quickbtns { display: flex; gap: 4px; }\r\n#q2w-hierarchical-switcher .q2w-tree-quickbtns button { flex: 1 1 0; font-size: 11px; padding: 2px 4px; border: 1px solid #cbd5e1; border-radius: 5px; background: #ffffff; color: #334155; cursor: pointer; font-weight: 500; }\r\n#q2w-hierarchical-switcher .q2w-tree-quickbtns button:hover { background: #eff6ff; border-color: #93c5fd; color: #1d4ed8; }\r\n#q2w-hierarchical-switcher .q2w-grayscale-bar { flex: 0 0 auto; display: flex; align-items: center; gap: 7px; padding: 5px 10px; background: #f1f5f9; border-bottom: 1px solid #e2e8f0; cursor: pointer; font-size: 12px; font-weight: 600; color: #1e293b; user-select: none; }\r\n#q2w-hierarchical-switcher .q2w-grayscale-bar:hover { background: #e2e8f0; }\r\n#q2w-hierarchical-switcher .q2w-tree-body { flex: 1 1 auto; min-height: 0; overflow-x: hidden; overflow-y: auto; padding: 6px 7px 26px 7px; -webkit-overflow-scrolling: touch; overscroll-behavior: contain; touch-action: pan-y; }\r\n#q2w-hierarchical-switcher .q2w-tree-row { display: flex; align-items: center; gap: 4px; min-height: 24px; padding: 2px 4px; border-radius: 5px; min-width: 0; width: 100%; transition: background .12s; }\r\n#q2w-hierarchical-switcher .q2w-tree-row:hover { background: #f1f5f9; }\r\n#q2w-hierarchical-switcher .q2w-layer-row-selected { background: #dbeafe !important; color: #1e3a8a !important; font-weight: 600 !important; box-shadow: inset 2px 0 0 #2563eb; }\r\n#q2w-hierarchical-switcher .q2w-tree-group-row { font-weight: 600; color: #0f172a; }\r\n#q2w-hierarchical-switcher .q2w-tree-layer-row { padding-left: 14px; font-weight: 400; color: #334155; }\r\n#q2w-hierarchical-switcher .q2w-tree-children { padding-left: 9px; margin-left: 5px; border-left: 1px dashed #cbd5e1; min-width: 0; }\r\n#q2w-hierarchical-switcher .q2w-tree-disclosure { flex: 0 0 16px; width: 16px; height: 18px; font-size: 11px; line-height: 16px; padding: 0; border: 0; background: transparent; color: #475569; cursor: pointer; }\r\n#q2w-hierarchical-switcher input.q2w-tree-check { display: inline-block !important; visibility: visible !important; opacity: 1 !important; appearance: auto; -webkit-appearance: checkbox; width: 14px; height: 14px; flex: 0 0 14px; margin: 0 2px 0 0; padding: 0; cursor: pointer; accent-color: #2563eb; }\r\n#q2w-hierarchical-switcher .q2w-layer-inline-icon { width: 16px; height: 16px; object-fit: contain; flex: 0 0 16px; margin-right: 2px; cursor: pointer; }\r\n#q2w-hierarchical-switcher .q2w-tree-label { flex: 1 1 auto; min-width: 0; overflow-wrap: anywhere; white-space: normal; cursor: pointer; font-size: 12.5px; line-height: 16px; }\r\n#q2w-hierarchical-switcher .q2w-tree-layer-row .q2w-tree-label:hover { color: #1d4ed8; text-decoration: underline; }\r\n#q2w-hierarchical-switcher .q2w-legend-toggle-btn { font-size: 10px; padding: 1px 5px; border: 1px solid #cbd5e1; border-radius: 4px; background: #f8fafc; color: #475569; cursor: pointer; flex: 0 0 auto; }\r\n#q2w-hierarchical-switcher .q2w-legend-toggle-btn.active, #q2w-hierarchical-switcher .q2w-legend-toggle-btn:hover { background: #eff6ff; border-color: #93c5fd; color: #1d4ed8; }\r\n#q2w-hierarchical-switcher .q2w-layer-legend-box { margin: 2px 0 6px 28px; padding: 5px 8px; background: #f8fafc; border: 1px solid #e2e8f0; border-radius: 6px; overflow-x: auto; cursor: pointer; }\r\n#q2w-hierarchical-switcher .q2w-merged-legend-img { display: block; max-width: 100%; height: auto; }\r\n#q2w-hierarchical-switcher .q2w-legend-subrow { display: flex; align-items: center; gap: 6px; font-size: 11.5px; padding: 2px 0; }\r\n#q2w-hierarchical-switcher .q2w-group-opacity-control { display: flex; align-items: center; gap: 3px; flex: 0 0 56px; width: 56px; min-width: 56px; margin-left: auto; font-weight: normal; }\r\n#q2w-hierarchical-switcher .q2w-group-opacity-slider { display: block; flex: 0 0 32px; width: 32px; min-width: 32px; height: 8px; padding: 0; margin: 0; cursor: pointer; appearance: none; -webkit-appearance: none; background: transparent; }\r\n#q2w-hierarchical-switcher .q2w-group-opacity-slider::-webkit-slider-runnable-track { height: 3px; border-radius: 2px; background: #cbd5e1; }\r\n#q2w-hierarchical-switcher .q2w-group-opacity-slider::-webkit-slider-thumb { -webkit-appearance: none; width: 9px; height: 9px; margin-top: -3px; border: 0; border-radius: 50%; background: #2563eb; }\r\n#q2w-hierarchical-switcher .q2w-group-opacity-slider::-moz-range-track { height: 3px; border: 0; border-radius: 2px; background: #cbd5e1; }\r\n#q2w-hierarchical-switcher .q2w-group-opacity-slider::-moz-range-thumb { width: 9px; height: 9px; border: 0; border-radius: 50%; background: #2563eb; }\r\n#q2w-hierarchical-switcher .q2w-group-opacity-value { display: inline-block; flex: 0 0 21px; width: 21px; text-align: right; font-size: 9.5px; color: #64748b; white-space: nowrap; }\r\n#q2w-info-frame { position: fixed; left: 10px; bottom: 10px; z-index: 1050; width: 365px; max-width: calc(100vw - 20px); max-height: 62vh; background: rgba(255,255,255,0.98); backdrop-filter: blur(8px); border: 1px solid #cbd5e1; border-radius: 10px; box-shadow: 0 10px 30px rgba(15,23,42,0.22); display: flex; flex-direction: column; overflow: hidden; font: 13px/1.4 -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Arial, sans-serif; color: #1e293b; pointer-events: auto; }\r\n.q2w-info-header { flex: 0 0 auto; display: flex; align-items: flex-start; justify-content: space-between; gap: 8px; padding: 8px 11px; background: linear-gradient(90deg, #0f172a, #1e3a8a); color: #ffffff; }\r\n.q2w-info-badge { display: inline-block; font-size: 9px; font-weight: 700; letter-spacing: 0.05em; color: #93c5fd; margin-bottom: 1px; }\r\n.q2w-info-layer-name { margin: 0; font-size: 13px; font-weight: 600; color: #ffffff; word-break: break-word; }\r\n.q2w-info-actions { display: flex; align-items: center; gap: 4px; flex: 0 0 auto; }\r\n.q2w-info-btn { border: 1px solid rgba(255,255,255,0.25); border-radius: 5px; background: rgba(255,255,255,0.12); color: #ffffff; font-size: 11px; padding: 3px 6px; cursor: pointer; white-space: nowrap; }\r\n.q2w-info-btn:hover { background: rgba(255,255,255,0.24); }\r\n.q2w-info-close { border: 0; background: transparent; color: #ffffff; font-size: 20px; line-height: 1; padding: 0 4px; cursor: pointer; opacity: 0.85; }\r\n.q2w-info-close:hover { opacity: 1; }\r\n.q2w-info-pager { flex: 0 0 auto; display: flex; align-items: center; justify-content: space-between; padding: 4px 11px; background: #eff6ff; border-bottom: 1px solid #bfdbfe; font-size: 11.5px; font-weight: 600; color: #1e40af; }\r\n.q2w-pager-btn { border: 1px solid #93c5fd; border-radius: 4px; background: #ffffff; color: #1d4ed8; font-size: 11px; padding: 2px 7px; cursor: pointer; }\r\n.q2w-info-body { flex: 1 1 auto; min-height: 0; overflow-y: auto; padding: 0 0 8px 0; -webkit-overflow-scrolling: touch; overscroll-behavior: contain; touch-action: pan-y; }\r\n.q2w-info-table { width: 100%; border-collapse: collapse; font-size: 12px; }\r\n.q2w-info-table th { text-align: left; padding: 5px 10px; background: #f8fafc; border-bottom: 1px solid #e2e8f0; color: #475569; font-size: 10.5px; text-transform: uppercase; position: sticky; top: 0; z-index: 1; }\r\n.q2w-info-table td { padding: 5px 10px; border-bottom: 1px solid #f1f5f9; vertical-align: top; }\r\n.q2w-info-table tr:nth-child(even) td { background: #f8fafc; }\r\n.q2w-info-key { width: 42%; font-weight: 600; color: #334155; word-break: break-word; }\r\n.q2w-info-val { width: 58%; color: #0f172a; overflow-wrap: anywhere; }\r\n.q2w-null-val { color: #94a3b8; font-style: italic; }\r\n#popup-content { max-height: 65vh !important; max-width: 65vw !important; overflow: auto !important; overscroll-behavior: contain; }\r\n.ol-popup { max-width: calc(100vw - 24px); }\r\n.layer-switcher:not(#q2w-hierarchical-switcher), .ol-layerswitcher:not(#q2w-hierarchical-switcher), .ol-layer-switcher:not(#q2w-hierarchical-switcher) { display: none !important; }\r\n/* Portrait phone responsive rules */\r\n@media (max-width: 640px) {\r\n  #q2w-hierarchical-switcher { width: calc(100vw - 16px); min-width: 0; max-width: 340px; top: 8px !important; right: 8px !important; left: auto !important; }\r\n  #q2w-hierarchical-switcher .q2w-tree-body { padding: 4px 6px 28px 6px; }\r\n  #q2w-info-frame { left: 8px; right: 8px; bottom: 8px; width: auto; max-height: 48dvh; }\r\n}\r\n/* Landscape phone & short viewport rules: make the entire content area scroll as one unified container so every layer/group is reachable */\r\n@media (max-height: 520px) {\r\n  #q2w-hierarchical-switcher { top: 6px !important; right: 6px !important; max-width: 320px; min-width: 230px; }\r\n  #q2w-hierarchical-switcher .q2w-tree-titlebar { padding: 5px 8px; }\r\n  #q2w-hierarchical-switcher .q2w-tree-panel-content { overflow-x: hidden; overflow-y: auto !important; -webkit-overflow-scrolling: touch; overscroll-behavior: contain; touch-action: pan-y; }\r\n  #q2w-hierarchical-switcher .q2w-tree-toolbar { padding: 4px 6px; }\r\n  #q2w-hierarchical-switcher .q2w-tree-search { height: 24px; margin-bottom: 3px; font-size: 11.5px; }\r\n  #q2w-hierarchical-switcher .q2w-grayscale-bar { padding: 4px 8px; font-size: 11.5px; }\r\n  #q2w-hierarchical-switcher .q2w-tree-body { flex: 0 0 auto !important; overflow: visible !important; max-height: none !important; padding: 4px 6px 32px 6px !important; }\r\n  #q2w-hierarchical-switcher .q2w-tree-row { min-height: 22px; padding: 1px 3px; }\r\n  #q2w-hierarchical-switcher .q2w-tree-children { padding-left: 6px; margin-left: 3px; }\r\n  #q2w-info-frame { left: 6px; bottom: 6px; width: 320px; max-width: calc(55vw - 12px); }\r\n  .q2w-info-header { padding: 5px 9px; }\r\n}\r\n";

  function installCss() {
    if (document.getElementById('q2w-hierarchical-style')) return;
    var style = document.createElement('style');
    style.id = 'q2w-hierarchical-style';
    style.type = 'text/css';
    style.appendChild(document.createTextNode(css));
    (document.head || document.documentElement).appendChild(style);
  }

  /* Pure-JS SHA-256 for offline file:// and http(s):// passcode verification */
  function sha256Hex(ascii) {
    function rightRotate(value, amount) { return (value >>> amount) | (value << (32 - amount)); }
    var utf8 = unescape(encodeURIComponent(ascii));
    var mathPow = Math.pow, maxWord = mathPow(2, 32), lengthProperty = 'length', i, j, result = '';
    var words = [], asciiBitLength = utf8[lengthProperty] * 8;
    var hash = [], k = [], primeCounter = 0, isComposite = {};
    for (var candidate = 2; primeCounter < 64; candidate++) {
      if (!isComposite[candidate]) {
        for (i = 0; i < 313; i += candidate) isComposite[i] = candidate;
        hash[primeCounter] = (mathPow(candidate, .5) * maxWord) | 0;
        k[primeCounter++] = (mathPow(candidate, 1 / 3) * maxWord) | 0;
      }
    }
    utf8 += '\x80';
    while (utf8[lengthProperty] % 64 - 56) utf8 += '\x00';
    for (i = 0; i < utf8[lengthProperty]; i++) {
      j = utf8.charCodeAt(i);
      words[i >> 2] |= j << ((3 - i) % 4) * 8;
    }
    words[words[lengthProperty]] = ((asciiBitLength / maxWord) | 0);
    words[words[lengthProperty]] = (asciiBitLength);
    for (j = 0; j < words[lengthProperty];) {
      var w = words.slice(j, j += 16), oldHash = hash.slice(0);
      for (i = 0; i < 64; i++) {
        var w15 = w[i - 15], w2 = w[i - 2];
        var a = hash[0], e = hash[4];
        var temp1 = hash[7] + (rightRotate(e, 6) ^ rightRotate(e, 11) ^ rightRotate(e, 25)) + ((e & hash[5]) ^ ((~e) & hash[6])) + k[i] + (w[i] = (i < 16) ? w[i] : (w[i - 16] + (rightRotate(w15, 7) ^ rightRotate(w15, 18) ^ (w15 >>> 3)) + w[i - 7] + (rightRotate(w2, 17) ^ rightRotate(w2, 19) ^ (w2 >>> 10))) | 0);
        var temp2 = (rightRotate(a, 2) ^ rightRotate(a, 13) ^ rightRotate(a, 22)) + ((a & hash[1]) ^ (a & hash[2]) ^ (hash[1] & hash[2]));
        hash = [(temp1 + temp2) | 0].concat(hash);
        hash[4] = (hash[4] + temp1) | 0;
        hash.pop();
      }
      for (i = 0; i < 8; i++) hash[i] = (hash[i] + oldHash[i]) | 0;
    }
    for (i = 0; i < 8; i++) {
      for (j = 3; j + 1; j--) {
        var b = (hash[i] >> (j * 8)) & 255;
        result += ((b < 16) ? 0 : '') + b.toString(16);
      }
    }
    return result;
  }

  function authStorageKey() { return 'q2wAuth:' + window.location.pathname; }
  function isSessionAuthenticated() {
    if (!appSettings.requirePassword || !appSettings.passwordHash) return true;
    try { return window.sessionStorage.getItem(authStorageKey()) === appSettings.passwordHash; } catch (e) { return false; }
  }
  function installSecurityGateIfNeeded() {
    installCss();
    if (isSessionAuthenticated()) {
      document.documentElement.classList.remove('q2w-locked');
      return;
    }
    document.documentElement.classList.add('q2w-locked');
    function mountGate() {
      if (document.getElementById('q2w-security-gate')) return;
      var gate = document.createElement('div');
      gate.id = 'q2w-security-gate';
      gate.className = 'q2w-security-gate';
      var card = document.createElement('div');
      card.className = 'q2w-security-card';
      card.innerHTML = '<div class="q2w-sec-icon"><svg viewBox="0 0 24 24" width="32" height="32" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect><path d="M7 11V7a5 5 0 0 1 10 0v4"></path></svg></div>' +
        '<h2 class="q2w-sec-title">Bản đồ WebGIS được bảo mật</h2>' +
        '<p class="q2w-sec-desc">Vui lòng nhập mã bảo mật để mở khóa và tra cứu dữ liệu bản đồ.</p>' +
        '<div class="q2w-sec-input-wrap"><input type="password" id="q2w-sec-input" class="q2w-sec-input" placeholder="Nhập mã bảo mật..." autocomplete="off" /><button type="button" id="q2w-sec-eye" class="q2w-sec-eye" title="Hiện/ẩn mã">👁</button></div>' +
        '<label class="q2w-sec-remember"><input type="checkbox" id="q2w-sec-rem" checked /> Ghi nhớ trong phiên làm việc này</label>' +
        '<div id="q2w-sec-error" class="q2w-sec-error" style="display:none;">Mã bảo mật không chính xác. Vui lòng thử lại!</div>' +
        '<button type="button" id="q2w-sec-submit" class="q2w-sec-submit">Mở khóa bản đồ</button>';
      gate.appendChild(card);
      document.body.appendChild(gate);
      var input = document.getElementById('q2w-sec-input');
      var eye = document.getElementById('q2w-sec-eye');
      var rem = document.getElementById('q2w-sec-rem');
      var err = document.getElementById('q2w-sec-error');
      var btn = document.getElementById('q2w-sec-submit');
      eye.addEventListener('click', function () { input.type = input.type === 'password' ? 'text' : 'password'; input.focus(); });
      function tryUnlock() {
        var val = (input.value || '').replace(/^\s+|\s+$/g, '');
        var computed = sha256Hex("q2w_sec_v2:" + val);
        if (computed === appSettings.passwordHash) {
          if (rem && rem.checked) { try { window.sessionStorage.setItem(authStorageKey(), appSettings.passwordHash); } catch (e) {} }
          document.documentElement.classList.remove('q2w-locked');
          gate.parentNode.removeChild(gate);
          if (window.map && typeof window.map.updateSize === 'function') window.map.updateSize();
        } else {
          err.style.display = 'block';
          card.classList.remove('q2w-shake');
          void card.offsetWidth;
          card.classList.add('q2w-shake');
          input.select();
        }
      }
      btn.addEventListener('click', tryUnlock);
      input.addEventListener('keydown', function (e) { if (e.key === 'Enter' || e.keyCode === 13) { e.preventDefault(); tryUnlock(); } });
      window.setTimeout(function () { input.focus(); }, 60);
    }
    if (document.body) mountGate(); else document.addEventListener('DOMContentLoaded', mountGate);
  }
  installSecurityGateIfNeeded();

  function hideNativeSwitcher() {
    var selectors = ['.layer-switcher', '.ol-layerswitcher', '.ol-layer-switcher'];
    for (var s = 0; s < selectors.length; s++) {
      var found = document.querySelectorAll(selectors[s]);
      for (var i = 0; i < found.length; i++) {
        if (!found[i].classList.contains('q2w-hierarchical-switcher')) found[i].style.display = 'none';
      }
    }
  }

  function getLayer(variableName) {
