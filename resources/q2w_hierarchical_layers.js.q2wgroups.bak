  function applyAllPopupFieldSettings() { for (var i = 0; i < treeConfig.length; i++) applyPopupFields(treeConfig[i]); }

  function refreshChecks(container) {
    var checks = container.querySelectorAll('input.q2w-tree-check');
    for (var i = 0; i < checks.length; i++) {
      var check = checks[i], node = check._q2wNode;
      if (!node) continue;
      if (node.kind === 'layer') {
        var layer = getLayer(node.variable); check.disabled = !layer; check.indeterminate = false; check.checked = !!layer && layer.getVisible();
      } else {
        var layers = []; collectLayers(node, layers); var visibleCount = 0;
        for (var j = 0; j < layers.length; j++) if (layers[j].getVisible()) visibleCount++;
        check.disabled = layers.length === 0; check.checked = layers.length > 0 && visibleCount === layers.length; check.indeterminate = visibleCount > 0 && visibleCount < layers.length;
      }
    }
  }

  /* Interactive Frame Info & Map Feature Selection from Legend/Layer Click */
  var infoFrameState = { matches: [], index: 0, highlightLayer: null, highlightSource: null, activeRow: null };
  function ensureHighlightLayer() {
    if (infoFrameState.highlightLayer || !window.map || !window.ol) return;
    try {
      infoFrameState.highlightSource = new ol.source.Vector();
      var defaultStyle = new ol.style.Style({
        stroke: new ol.style.Stroke({ color: '#0284c7', width: 2.5 }),
        fill: new ol.style.Fill({ color: 'rgba(14, 165, 233, 0.14)' }),
        image: new ol.style.Circle({ radius: 6, fill: new ol.style.Fill({ color: '#0284c7' }), stroke: new ol.style.Stroke({ color: '#ffffff', width: 1.5 }) })
      });
      var activeStyle = new ol.style.Style({
        stroke: new ol.style.Stroke({ color: '#dc2626', width: 3.5 }),
        fill: new ol.style.Fill({ color: 'rgba(239, 68, 68, 0.24)' }),
        image: new ol.style.Circle({ radius: 8, fill: new ol.style.Fill({ color: '#dc2626' }), stroke: new ol.style.Stroke({ color: '#ffffff', width: 2 }) })
      });
      infoFrameState.highlightLayer = new ol.layer.Vector({
        source: infoFrameState.highlightSource,
        style: function (feat) { return (feat && feat.get && feat.get('_q2wActive')) ? activeStyle : defaultStyle; },
        zIndex: 9999
      });
      window.map.addLayer(infoFrameState.highlightLayer);
    } catch (e) {}
  }
  function clearFeatureHighlight() {
    if (infoFrameState.highlightSource) { try { infoFrameState.highlightSource.clear(); } catch (e) {} }
    if (infoFrameState.activeRow) { infoFrameState.activeRow.classList.remove('q2w-layer-row-selected'); infoFrameState.activeRow = null; }
  }
  function updateMapHighlightForMatches() {
    ensureHighlightLayer();
    if (!infoFrameState.highlightSource) return;
    try {
      infoFrameState.highlightSource.clear();
      var total = infoFrameState.matches.length;
      var maxHighlight = Math.min(total, 500);
      for (var i = 0; i < maxHighlight; i++) {
        var f = infoFrameState.matches[i].feature;
        if (!f || !f.clone) continue;
        var cloned = f.clone();
        cloned.set('_q2wActive', i === infoFrameState.index);
        infoFrameState.highlightSource.addFeature(cloned);
      }
      if (infoFrameState.index >= maxHighlight && infoFrameState.matches[infoFrameState.index] && infoFrameState.matches[infoFrameState.index].feature) {
        var activeClone = infoFrameState.matches[infoFrameState.index].feature.clone();
        activeClone.set('_q2wActive', true);
        infoFrameState.highlightSource.addFeature(activeClone);
      }
    } catch (e) {}
  }
  function collectFeaturesFromLayer(layer) {
    var result = [];
    if (!layer || typeof layer.getSource !== 'function') return result;
    try {
      var src = layer.getSource();
      if (src && typeof src.getSource === 'function' && src.getSource()) src = src.getSource();
      if (src && typeof src.getFeatures === 'function') {
        var raw = src.getFeatures() || [];
        for (var i = 0; i < raw.length; i++) {
          var f = raw[i];
          var sub = (f && typeof f.get === 'function' && Array.isArray(f.get('features'))) ? f.get('features') : [f];
          for (var j = 0; j < sub.length; j++) if (sub[j]) result.push(sub[j]);
        }
      }
    } catch (e) {}
    return result;
  }
  function fitFeaturesExtentOnMap(features, fallbackLayer) {
    if (!window.map || !window.map.getView || !window.ol || !window.ol.extent) return;
    try {
      var ext = ol.extent.createEmpty();
      var hasGeom = false;
      for (var i = 0; i < features.length; i++) {
        var g = features[i] && typeof features[i].getGeometry === 'function' ? features[i].getGeometry() : null;
        if (g && typeof g.getExtent === 'function') {
          ol.extent.extend(ext, g.getExtent());
          hasGeom = true;
        }
      }
      if (!hasGeom && fallbackLayer && typeof fallbackLayer.getExtent === 'function' && fallbackLayer.getExtent()) {
        ext = fallbackLayer.getExtent();
        hasGeom = !ol.extent.isEmpty(ext);
      }
      if (hasGeom && !ol.extent.isEmpty(ext)) {
        window.map.getView().fit(ext, { duration: 380, padding: [55, 55, 55, 55], maxZoom: 18 });
      }
    } catch (e) {}
  }
  function selectLayerOnMapAndShowInfo(node, rowElement, container) {
    if (!node || node.kind !== 'layer') return;
    ensureInfoFrameMounted();
    var layer = getLayer(node.variable);
    if (!layer) return;
    if (!layer.getVisible()) {
      setLeafVisible(node, true);
      if (container) refreshChecks(container);
    }
    if (infoFrameState.activeRow) infoFrameState.activeRow.classList.remove('q2w-layer-row-selected');
    if (rowElement) { rowElement.classList.add('q2w-layer-row-selected'); infoFrameState.activeRow = rowElement; }
    var features = collectFeaturesFromLayer(layer);
    var lTitle = node.title || ((typeof layer.get === 'function' && (layer.get('popuplayertitle') || layer.get('title'))) || 'Lớp bản đồ');
    lTitle = String(lTitle).replace(/<[^>]*>/g, ' ').replace(/\s+/g, ' ').replace(/^\s+|\s+$/g, '');
    var found = [];
    for (var i = 0; i < features.length; i++) {
      var rows = extractFeatureDisplayRows(features[i], layer, node, true);
      found.push({ feature: features[i], layer: layer, layerTitle: lTitle, rows: rows });
    }
    if (found.length === 0) {
      var summaryRows = [
        { field: 'title', alias: 'Tên lớp', rawValue: lTitle, htmlValue: formatFieldValue(lTitle) },
        { field: 'opacity', alias: 'Độ đục (Opacity)', rawValue: Math.round(clampOpacity(node.opacity) * 100) + '%', htmlValue: Math.round(clampOpacity(node.opacity) * 100) + '%' }
      ];
      found.push({ feature: null, layer: layer, layerTitle: lTitle, rows: summaryRows });
    }
    infoFrameState.matches = found;
    infoFrameState.index = 0;
    renderCurrentInfoFeature();
    fitFeaturesExtentOnMap(features, layer);
  }

  function addCheck(row, node, container) {
    var check = document.createElement('input'); check.type = 'checkbox'; check.className = 'q2w-tree-check'; check._q2wNode = node;
    check.setAttribute('aria-label', (node.kind === 'group' ? 'Bật/tắt nhóm: ' : 'Bật/tắt lớp: ') + (node.title || node.variable || 'Mục không tên'));
    check.title = node.kind === 'group' ? 'Đánh dấu để bật/tắt nhóm' : 'Đánh dấu để bật/tắt lớp';
    check.addEventListener('click', function (event) { event.stopPropagation(); });
    check.addEventListener('change', function () { setNodeVisible(node, check.checked); refreshChecks(container); });
    row.appendChild(check);
    if (node.kind === 'layer' && node.singleIconLegend && node.legendDataUri) {
      var icon = document.createElement('img'); icon.className = 'q2w-layer-inline-icon'; icon.src = node.legendDataUri; icon.alt = '';
      icon.title = 'Bấm để chọn đối tượng của lớp trên bản đồ và xem thông tin';
      icon.addEventListener('click', function (event) { event.stopPropagation(); selectLayerOnMapAndShowInfo(node, row, container); });
      row.appendChild(icon);
    }
    var label = document.createElement('span'); label.className = 'q2w-tree-label'; label.textContent = node.title || node.variable || 'Mục không tên';
    if (node.kind === 'layer') {
      label.title = 'Bấm để chọn đối tượng của lớp trên bản đồ và hiển thị thông tin';
      label.addEventListener('click', function (event) { event.stopPropagation(); selectLayerOnMapAndShowInfo(node, row, container); });
    } else {
      label.title = node.title || '';
      label.addEventListener('click', function (event) { event.stopPropagation(); check.checked = !check.checked; check.dispatchEvent(new Event('change', { bubbles: true })); });
    }
    row.appendChild(label);
  }

  function addOpacitySlider(row, node, nodeKey) {
    var wrap = document.createElement('span'); wrap.className = 'q2w-group-opacity-control';
    var slider = document.createElement('input'); slider.type = 'range'; slider.min = '0'; slider.max = '100'; slider.step = '1'; slider.className = 'q2w-group-opacity-slider';
    slider.value = String(Math.round(clampOpacity(node.opacity) * 100));
    var value = document.createElement('span'); value.className = 'q2w-group-opacity-value';
    function updateValue() { value.textContent = slider.value + '%'; wrap.title = 'Độ đục: ' + slider.value + '%'; }
    slider.addEventListener('click', function (e) { e.stopPropagation(); });
    slider.addEventListener('mousedown', function (e) { e.stopPropagation(); });
    slider.addEventListener('touchstart', function (e) { e.stopPropagation(); }, { passive: true });
    slider.addEventListener('touchmove', function (e) { e.stopPropagation(); }, { passive: true });
    slider.addEventListener('input', function () { node.opacity = clampOpacity(Number(slider.value) / 100); updateValue(); applyAllGroupOpacities(); saveStoredOpacity(nodeKey, node.opacity); });
    slider.addEventListener('change', function () { node.opacity = clampOpacity(Number(slider.value) / 100); saveStoredOpacity(nodeKey, node.opacity); });
    updateValue(); wrap.appendChild(slider); wrap.appendChild(value); row.appendChild(wrap);
  }

  function buildNode(node, parent, container, nodeKey) {
    node.opacityId = node.opacityId || nodeKey;
    node.opacity = readStoredOpacity(node.opacityId, typeof node.opacity === 'number' ? node.opacity : 1);
    if (node.kind === 'group') {
      var group = document.createElement('div'); group.className = 'q2w-tree-group'; group.setAttribute('data-q2w-title', (node.title || '').toLowerCase());
      var header = document.createElement('div'); header.className = 'q2w-tree-row q2w-tree-group-row'; group.appendChild(header);
      var disclosure = document.createElement('button'); disclosure.type = 'button'; disclosure.className = 'q2w-tree-disclosure'; disclosure.textContent = '▾'; disclosure.title = 'Thu gọn / Mở rộng nhóm'; header.appendChild(disclosure);
      addCheck(header, node, container); addOpacitySlider(header, node, node.opacityId);
      var children = document.createElement('div'); children.className = 'q2w-tree-children'; group.appendChild(children);
      var initiallyExpanded = node.expanded !== false; children.style.display = initiallyExpanded ? '' : 'none'; disclosure.textContent = initiallyExpanded ? '▾' : '▸';
      disclosure.addEventListener('click', function (e) { e.preventDefault(); e.stopPropagation(); var closed = children.style.display === 'none'; children.style.display = closed ? '' : 'none'; disclosure.textContent = closed ? '▾' : '▸'; });
      for (var i = 0; i < (node.children || []).length; i++) buildNode(node.children[i], children, container, node.opacityId + '.' + i);
      parent.appendChild(group);
    } else {
      var itemWrap = document.createElement('div'); itemWrap.className = 'q2w-tree-layer-item'; itemWrap.setAttribute('data-q2w-title', (node.title || '').toLowerCase());
      var row = document.createElement('div'); row.className = 'q2w-tree-row q2w-tree-layer-row';
      addCheck(row, node, container);
      var hasMultiLegend = !node.singleIconLegend && ((node.legendDataUri && node.legendDataUri.length > 0) || (node.legendItems && node.legendItems.length > 0));
      var legendBox = null;
      if (hasMultiLegend) {
        var legBtn = document.createElement('button'); legBtn.type = 'button'; legBtn.className = 'q2w-legend-toggle-btn'; legBtn.textContent = 'Chú giải'; legBtn.title = 'Ẩn/hiện ký hiệu chú giải của lớp';
        row.appendChild(legBtn);
        legendBox = document.createElement('div'); legendBox.className = 'q2w-layer-legend-box'; legendBox.style.display = 'none';
        legendBox.title = 'Bấm vào chú giải để chọn đối tượng của lớp trên bản đồ';
        legendBox.addEventListener('click', function (e) { e.stopPropagation(); selectLayerOnMapAndShowInfo(node, row, container); });
        if (node.legendDataUri) {
          var mergedImg = document.createElement('img'); mergedImg.className = 'q2w-merged-legend-img'; mergedImg.src = node.legendDataUri; mergedImg.alt = node.title || 'Legend';
          legendBox.appendChild(mergedImg);
        } else if (node.legendRelPath) {
          var mergedFileImg = document.createElement('img'); mergedFileImg.className = 'q2w-merged-legend-img'; mergedFileImg.src = node.legendRelPath; mergedFileImg.alt = node.title || 'Legend';
          legendBox.appendChild(mergedFileImg);
        } else if (node.legendItems) {
          for (var l = 0; l < node.legendItems.length; l++) {
            var li = node.legendItems[l], lRow = document.createElement('div'); lRow.className = 'q2w-legend-subrow';
            var lImg = document.createElement('img'); lImg.src = li.src; lImg.alt = ''; lRow.appendChild(lImg);
            var lTxt = document.createElement('span'); lTxt.textContent = li.label || ''; lRow.appendChild(lTxt);
            legendBox.appendChild(lRow);
          }
        }
        legBtn.addEventListener('click', function (e) { e.stopPropagation(); var open = legendBox.style.display !== 'none'; legendBox.style.display = open ? 'none' : 'block'; legBtn.classList.toggle('active', !open); });
      }
      addOpacitySlider(row, node, node.opacityId);
      itemWrap.appendChild(row);
      if (legendBox) itemWrap.appendChild(legendBox);
      parent.appendChild(itemWrap);
    }
  }

  function filterTreeDom(body, query) {
    var q = (query || '').replace(/^\s+|\s+$/g, '').toLowerCase();
    var layers = body.querySelectorAll('.q2w-tree-layer-item');
    for (var i = 0; i < layers.length; i++) {
      var t = layers[i].getAttribute('data-q2w-title') || '';
      layers[i].style.display = (!q || t.indexOf(q) >= 0) ? '' : 'none';
    }
    var groups = body.querySelectorAll('.q2w-tree-group');
    for (var g = groups.length - 1; g >= 0; g--) {
      var grp = groups[g], gt = grp.getAttribute('data-q2w-title') || '';
      if (!q) { grp.style.display = ''; continue; }
      if (gt.indexOf(q) >= 0) {
        grp.style.display = '';
        var subItems = grp.querySelectorAll('.q2w-tree-layer-item, .q2w-tree-group');
        for (var s = 0; s < subItems.length; s++) subItems[s].style.display = '';
        var ch = grp.querySelector('.q2w-tree-children'); if (ch) ch.style.display = '';
      } else {
        var visibleChild = false;
        var childLayers = grp.querySelectorAll('.q2w-tree-layer-item');
        for (var c = 0; c < childLayers.length; c++) { if (childLayers[c].style.display !== 'none') { visibleChild = true; break; } }
        grp.style.display = visibleChild ? '' : 'none';
        if (visibleChild) { var ch2 = grp.querySelector('.q2w-tree-children'); if (ch2) ch2.style.display = ''; }
      }
    }
  }

  function formatFieldValue(val) {
    if (val === null || val === undefined || val === '') return '<span class="q2w-null-val">—</span>';
    var str = String(val);
    if (/<(a|img|table|div|span|p|br)\b/i.test(str)) return str;
    var escaped = str.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');
    if (/^https?:\/\//i.test(str)) return '<a href="' + escaped + '" target="_blank" rel="noopener">' + escaped + '</a>';
    return escaped;
  }
  function isolatePanelScrollEvents(el) {
    if (!el) return;
    var events = ['wheel', 'touchstart', 'touchmove', 'touchend', 'pointerdown', 'mousedown', 'dblclick'];
    for (var i = 0; i < events.length; i++) {
      el.addEventListener(events[i], function (e) { e.stopPropagation(); }, { passive: true });
    }
  }
  function ensureInfoFrameMounted() {
    if (document.getElementById('q2w-info-frame')) return;
    if (appSettings.hideDefaultPopupWhenFrame) document.documentElement.classList.add('q2w-hide-native-popup');
    var frame = document.createElement('div');
    frame.id = 'q2w-info-frame';
    frame.className = 'q2w-info-frame';
    frame.style.display = 'none';
    frame.innerHTML = '<div class="q2w-info-header">' +
      '<div class="q2w-info-title-wrap"><span class="q2w-info-badge">THÔNG TIN ĐỐI TƯỢNG</span><h3 id="q2w-info-layer-name" class="q2w-info-layer-name">Chưa chọn đối tượng</h3></div>' +
      '<div class="q2w-info-actions">' +
        '<button type="button" id="q2w-info-zoom" class="q2w-info-btn" title="Phóng tới đối tượng">🔍 Phóng tới</button>' +
        '<button type="button" id="q2w-info-copy" class="q2w-info-btn" title="Sao chép thông tin">📋 Chép</button>' +
        '<button type="button" id="q2w-info-close" class="q2w-info-close" title="Đóng bảng thông tin">×</button>' +
      '</div>' +
    '</div>' +
    '<div id="q2w-info-pager" class="q2w-info-pager" style="display:none;">' +
      '<button type="button" id="q2w-info-prev" class="q2w-pager-btn">◀ Trước</button>' +
      '<span id="q2w-info-count" class="q2w-pager-count">1 / 1</span>' +
      '<button type="button" id="q2w-info-next" class="q2w-pager-btn">Tiếp ▶</button>' +
    '</div>' +
    '<div id="q2w-info-body" class="q2w-info-body"></div>';
    document.body.appendChild(frame);
    isolatePanelScrollEvents(frame);
    document.getElementById('q2w-info-close').addEventListener('click', function () { frame.style.display = 'none'; clearFeatureHighlight(); });
    document.getElementById('q2w-info-prev').addEventListener('click', function () {
      if (infoFrameState.matches.length > 1) {
        infoFrameState.index = (infoFrameState.index - 1 + infoFrameState.matches.length) % infoFrameState.matches.length;
        renderCurrentInfoFeature();
      }
    });
    document.getElementById('q2w-info-next').addEventListener('click', function () {
      if (infoFrameState.matches.length > 1) {
        infoFrameState.index = (infoFrameState.index + 1) % infoFrameState.matches.length;
        renderCurrentInfoFeature();
      }
    });
    document.getElementById('q2w-info-zoom').addEventListener('click', function () {
      var cur = infoFrameState.matches[infoFrameState.index];
      if (!cur || !cur.feature || !window.map) return;
      fitFeaturesExtentOnMap([cur.feature], cur.layer);
    });
    document.getElementById('q2w-info-copy').addEventListener('click', function () {
      var cur = infoFrameState.matches[infoFrameState.index];
      if (!cur) return;
      var lines = [cur.layerTitle];
      for (var r = 0; r < cur.rows.length; r++) lines.push(cur.rows[r].alias + ': ' + (cur.rows[r].rawValue !== null && cur.rows[r].rawValue !== undefined ? cur.rows[r].rawValue : ''));
      var text = lines.join('\n');
      try {
        var ta = document.createElement('textarea'); ta.value = text; ta.style.position = 'fixed'; ta.style.left = '-9999px'; document.body.appendChild(ta); ta.select(); document.execCommand('copy'); document.body.removeChild(ta);
        var copyBtn = document.getElementById('q2w-info-copy'); copyBtn.textContent = '✓ Đã chép'; window.setTimeout(function () { copyBtn.textContent = '📋 Chép'; }, 1500);
      } catch (e) {}
    });
  }
  function installInfoFrame() {
    ensureInfoFrameMounted();
    if (!appSettings.enableInfoFrame) return;
    window.map.on('singleclick', function (evt) {
      var frame = document.getElementById('q2w-info-frame');
      var found = [];
      window.map.forEachFeatureAtPixel(evt.pixel, function (feature, layer) {
        if (!layer || layer === infoFrameState.highlightLayer) return;
        var node = layer._q2wLayerNode || null;
        if (node && node.popupEnabled === false) return;
        if (typeof layer.get === 'function' && layer.get('interactive') === false) return;
        var subFeatures = (typeof feature.get === 'function' && Array.isArray(feature.get('features'))) ? feature.get('features') : [feature];
        for (var sf = 0; sf < subFeatures.length; sf++) {
          var fObj = subFeatures[sf];
          var rows = extractFeatureDisplayRows(fObj, layer, node, false);
          if (rows.length > 0) {
            var lTitle = (node && node.title) ? node.title : ((typeof layer.get === 'function' && (layer.get('popuplayertitle') || layer.get('title'))) || 'Lớp bản đồ');
            lTitle = String(lTitle).replace(/<[^>]*>/g, ' ').replace(/\s+/g, ' ').replace(/^\s+|\s+$/g, '');
            found.push({ feature: fObj, layer: layer, layerTitle: lTitle, rows: rows });
          }
        }
      }, { hitTolerance: 5 });
      if (found.length === 0) {
        if (frame) frame.style.display = 'none';
        clearFeatureHighlight();
        return;
      }
      infoFrameState.matches = found;
      infoFrameState.index = 0;
      renderCurrentInfoFeature();
    });
  }
  function extractFeatureDisplayRows(feature, layer, node, fallbackAllFields) {
    var rows = [];
    if (!feature || typeof feature.getProperties !== 'function') return rows;
    var props = feature.getProperties();
    var aliases = (node && node.popupAliases) ? node.popupAliases : ((layer && typeof layer.get === 'function' && layer.get('fieldAliases')) || {});
    var labels = (layer && typeof layer.get === 'function' && layer.get('fieldLabels')) || {};
    var fieldList = (node && node.popupConfigured && Array.isArray(node.popupFields) && node.popupFields.length > 0) ? node.popupFields : Object.keys(props);
    for (var i = 0; i < fieldList.length; i++) {
      var key = fieldList[i];
      if (key === 'geometry' || key === 'layerObject' || key === 'idO' || key === '_mvtLayer_' || key === 'features' || key === '_q2wActive') continue;
      if (!fallbackAllFields && !(node && node.popupConfigured) && labels[key] === 'hidden field') continue;
      if (!Object.prototype.hasOwnProperty.call(props, key)) continue;
      var displayAlias = (aliases && aliases[key]) ? aliases[key] : key;
      rows.push({ field: key, alias: displayAlias, rawValue: props[key], htmlValue: formatFieldValue(props[key]) });
    }
    return rows;
  }
  function renderCurrentInfoFeature() {
    ensureInfoFrameMounted();
    var frame = document.getElementById('q2w-info-frame');
    if (!frame || infoFrameState.matches.length === 0) return;
    var cur = infoFrameState.matches[infoFrameState.index];
    document.getElementById('q2w-info-layer-name').textContent = cur.layerTitle;
    var pager = document.getElementById('q2w-info-pager');
    if (infoFrameState.matches.length > 1) {
      pager.style.display = 'flex';
      document.getElementById('q2w-info-count').textContent = 'Đối tượng ' + (infoFrameState.index + 1) + ' / ' + infoFrameState.matches.length;
    } else {
      pager.style.display = 'none';
    }
    var body = document.getElementById('q2w-info-body');
    var html = '<table class="q2w-info-table"><thead><tr><th>Tên hiển thị</th><th>Giá trị</th></tr></thead><tbody>';
    for (var i = 0; i < cur.rows.length; i++) {
      var r = cur.rows[i];
      var safeAlias = String(r.alias).replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');
      html += '<tr><td class="q2w-info-key" title="Trường gốc: ' + r.field + '">' + safeAlias + '</td><td class="q2w-info-val">' + r.htmlValue + '</td></tr>';
    }
    html += '</tbody></table>';
    body.innerHTML = html;
    frame.style.display = 'flex';
    syncResponsiveHeights();
    updateMapHighlightForMatches();
  }

  function installPopupWheelBehavior() {
    var popup = document.getElementById('popup') || document.querySelector('.ol-popup');
    if (!popup || popup.getAttribute('data-q2w-wheel-installed') === '1') return;
    popup.setAttribute('data-q2w-wheel-installed', '1');
    popup.addEventListener('wheel', function (event) {
      var delta = (typeof event.deltaY === 'number') ? event.deltaY : (event.wheelDelta ? -event.wheelDelta : 0);
      if (!delta) return;
      if (event.cancelable) event.preventDefault();
      event.stopPropagation();
      if (popupWheelZoomOnPopup) {
        if (!window.map || !window.map.getView) return;
        var view = window.map.getView(); var zoomDelta = Math.max(-2, Math.min(2, -delta / 120));
        if (Math.abs(zoomDelta) < 0.01) return;
        try { var pixel = window.map.getEventPixel(event); var anchor = window.map.getCoordinateFromPixel(pixel); if (anchor) view.adjustZoom(zoomDelta, anchor); else view.adjustZoom(zoomDelta); } catch (e) { view.adjustZoom(zoomDelta); }
      } else {
        var content = document.getElementById('popup-content') || popup;
        if (content) content.scrollTop += delta;
      }
    }, { passive: false });
  }

  /* Responsive Height Sync for Portrait & Landscape Phones */
  function syncResponsiveHeights() {
    try {
      var vh = (window.visualViewport && window.visualViewport.height) ? window.visualViewport.height : (window.innerHeight || document.documentElement.clientHeight || 600);
      var switcher = document.getElementById('q2w-hierarchical-switcher');
      if (switcher) {
        var topGap = switcher.offsetTop || 8;
        var maxH = Math.max(120, Math.floor(vh - topGap - 10));
        switcher.style.maxHeight = maxH + 'px';
      }
      var infoFrame = document.getElementById('q2w-info-frame');
      if (infoFrame && infoFrame.style.display !== 'none') {
        var isShort = vh <= 520;
        infoFrame.style.maxHeight = Math.max(130, Math.floor(vh * (isShort ? 0.82 : 0.62))) + 'px';
      }
    } catch (e) {}
  }

  function init() {
    if (!window.map || !window.ol || !window.ol.control || !window.ol.control.Control) { window.setTimeout(init, 150); return; }
    if (document.getElementById('q2w-hierarchical-switcher')) return;
    installCss(); hideNativeSwitcher(); installPopupWheelBehavior();
    var root = document.createElement('div'); root.id = 'q2w-hierarchical-switcher'; root.className = 'ol-control q2w-hierarchical-switcher';
    isolatePanelScrollEvents(root);
    var header = document.createElement('div'); header.className = 'q2w-tree-titlebar'; root.appendChild(header);
    var titleWrap = document.createElement('div'); titleWrap.className = 'q2w-tree-title-wrap';
    titleWrap.innerHTML = '<svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2"><polygon points="12 2 2 7 12 12 22 7 12 2"></polygon><polyline points="2 17 12 22 22 17"></polyline><polyline points="2 12 12 17 22 12"></polyline></svg><span class="q2w-tree-title">Lớp bản đồ (Layers)</span>';
    header.appendChild(titleWrap);
    var collapse = document.createElement('button'); collapse.type = 'button'; collapse.className = 'q2w-tree-panel-toggle'; collapse.textContent = '−'; collapse.title = 'Thu gọn / Mở bảng điều khiển'; header.appendChild(collapse);
    var panelContent = document.createElement('div'); panelContent.className = 'q2w-tree-panel-content'; root.appendChild(panelContent);
    var toolbar = document.createElement('div'); toolbar.className = 'q2w-tree-toolbar'; panelContent.appendChild(toolbar);
    var searchInput = document.createElement('input'); searchInput.type = 'search'; searchInput.className = 'q2w-tree-search'; searchInput.placeholder = 'Tìm nhanh lớp / nhóm...'; toolbar.appendChild(searchInput);
    var quickBtns = document.createElement('div'); quickBtns.className = 'q2w-tree-quickbtns'; toolbar.appendChild(quickBtns);
    var btnCheckAll = document.createElement('button'); btnCheckAll.type = 'button'; btnCheckAll.textContent = 'Bật hết'; btnCheckAll.title = 'Hiển thị tất cả các lớp'; quickBtns.appendChild(btnCheckAll);
    var btnUncheckAll = document.createElement('button'); btnUncheckAll.type = 'button'; btnUncheckAll.textContent = 'Tắt hết'; btnUncheckAll.title = 'Ẩn tất cả các lớp'; quickBtns.appendChild(btnUncheckAll);
    var btnExpandAll = document.createElement('button'); btnExpandAll.type = 'button'; btnExpandAll.textContent = 'Mở nhóm'; btnExpandAll.title = 'Mở rộng tất cả các nhóm'; quickBtns.appendChild(btnExpandAll);
    var btnCollapseAll = document.createElement('button'); btnCollapseAll.type = 'button'; btnCollapseAll.textContent = 'Thu nhóm'; btnCollapseAll.title = 'Thu gọn tất cả các nhóm'; quickBtns.appendChild(btnCollapseAll);
    if (appSettings.enableGrayscaleControl) {
      var gsBar = document.createElement('label'); gsBar.className = 'q2w-grayscale-bar';
      var gsCheck = document.createElement('input'); gsCheck.type = 'checkbox'; gsCheck.className = 'q2w-tree-check';
      grayscaleEnabled = readStoredGrayscale();
      gsCheck.checked = grayscaleEnabled;
      var gsText = document.createElement('span'); gsText.className = 'q2w-grayscale-label'; gsText.textContent = 'Bản đồ nền đen trắng (Grayscale)';
      gsBar.appendChild(gsCheck); gsBar.appendChild(gsText); panelContent.appendChild(gsBar);
      gsCheck.addEventListener('change', function () { setGrayscaleBasemap(gsCheck.checked); });
    }
    var body = document.createElement('div'); body.className = 'q2w-tree-body'; panelContent.appendChild(body);
    collapse.addEventListener('click', function () { var hide = panelContent.style.display !== 'none'; panelContent.style.display = hide ? 'none' : ''; collapse.textContent = hide ? '+' : '−'; root.classList.toggle('q2w-collapsed', hide); syncResponsiveHeights(); });
    searchInput.addEventListener('input', function () { filterTreeDom(body, searchInput.value); });
    btnCheckAll.addEventListener('click', function () { for (var i = 0; i < treeConfig.length; i++) setNodeVisible(treeConfig[i], true); refreshChecks(root); });
    btnUncheckAll.addEventListener('click', function () { for (var i = 0; i < treeConfig.length; i++) setNodeVisible(treeConfig[i], false); refreshChecks(root); });
    btnExpandAll.addEventListener('click', function () { var ch = body.querySelectorAll('.q2w-tree-children'); for (var i = 0; i < ch.length; i++) ch[i].style.display = ''; var d = body.querySelectorAll('.q2w-tree-disclosure'); for (var j = 0; j < d.length; j++) d[j].textContent = '▾'; });
    btnCollapseAll.addEventListener('click', function () { var ch = body.querySelectorAll('.q2w-tree-children'); for (var i = 0; i < ch.length; i++) ch[i].style.display = 'none'; var d = body.querySelectorAll('.q2w-tree-disclosure'); for (var j = 0; j < d.length; j++) d[j].textContent = '▸'; });
    for (var i = 0; i < treeConfig.length; i++) buildNode(treeConfig[i], body, root, 'root.' + i);
    applyAllPopupFieldSettings();
    for (var j = 0; j < treeConfig.length; j++) applyInitialVisibility(treeConfig[j]);
    applyAllGroupOpacities();
    setGrayscaleBasemap(readStoredGrayscale());
    installInfoFrame();
    var control = new ol.control.Control({ element: root }); map.addControl(control);
    root.style.position = 'absolute'; root.style.top = '0.5em'; root.style.right = '0.5em'; root.style.zIndex = '1000';
    syncResponsiveHeights();
    window.addEventListener('resize', syncResponsiveHeights);
    window.addEventListener('orientationchange', function () { window.setTimeout(syncResponsiveHeights, 100); });
    if (window.visualViewport) window.visualViewport.addEventListener('resize', syncResponsiveHeights);
    hideNativeSwitcher(); refreshChecks(root);
    if (window.MutationObserver && document.body) { var observer = new MutationObserver(function () { hideNativeSwitcher(); }); observer.observe(document.body, { childList: true, subtree: true }); window.setTimeout(function(){ observer.disconnect(); }, 3000); }
  }
  if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', init); else init();
})();
