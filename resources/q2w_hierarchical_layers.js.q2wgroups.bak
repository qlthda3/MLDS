    if (window.map && typeof window.map.render === 'function') window.map.render();
  }

  function collectLayerNodes(node, result) {
    if (!node) return;
    if (node.kind === 'layer') { result.push(node); return; }
    for (var i = 0; i < (node.children || []).length; i++) collectLayerNodes(node.children[i], result);
  }
  function collectLayers(node, result) {
    var nodes = []; collectLayerNodes(node, nodes);
    for (var i = 0; i < nodes.length; i++) { var layer = getLayer(nodes[i].variable); if (layer && result.indexOf(layer) < 0) result.push(layer); }
  }
  function setLeafVisible(node, visible) {
    var layer = getLayer(node.variable); if (layer) layer.setVisible(visible);
    if (visible) { for (var i = 0; i < (node.ancestors || []).length; i++) { var groupLayer = getLayer(node.ancestors[i]); if (groupLayer) groupLayer.setVisible(true); } }
  }
  function setNodeVisible(node, visible) {
    var nodes = []; collectLayerNodes(node, nodes);
    for (var i = 0; i < nodes.length; i++) setLeafVisible(nodes[i], visible);
  }
  function applyInitialVisibility(node) {
    if (!node) return;
    if (node.kind === 'layer') { setLeafVisible(node, !!node.checked); return; }
    for (var i = 0; i < (node.children || []).length; i++) applyInitialVisibility(node.children[i]);
  }

  function copyPopupMap(source) { var result = {}; if (source) { for (var key in source) { if (Object.prototype.hasOwnProperty.call(source, key)) result[key] = source[key]; } } return result; }
  function applyPopupFields(node) {
    if (!node) return;
    if (node.kind === 'group') { for (var i = 0; i < (node.children || []).length; i++) applyPopupFields(node.children[i]); return; }
    var layer = getLayer(node.variable);
    if (!layer) return;
    layer._q2wLayerNode = node;
    if (!node.popupConfigured || node.popupFieldConfigurable !== true || !node.popupFields) return;
    if (typeof layer.get !== 'function' || typeof layer.set !== 'function') return;
    if (!layer._q2wPopupBaseAliases) layer._q2wPopupBaseAliases = copyPopupMap(layer.get('fieldAliases') || {});
    if (!layer._q2wPopupBaseLabels) layer._q2wPopupBaseLabels = copyPopupMap(layer.get('fieldLabels') || {});
    if (!layer._q2wPopupBaseImages) layer._q2wPopupBaseImages = copyPopupMap(layer.get('fieldImages') || {});
    var baseAliases = layer._q2wPopupBaseAliases, baseLabels = layer._q2wPopupBaseLabels, baseImages = layer._q2wPopupBaseImages;
    var aliases = copyPopupMap(baseAliases), labels = copyPopupMap(baseLabels), images = copyPopupMap(baseImages), keys = {};
    var mapSources = [baseLabels, baseImages, baseAliases];
    for (var s = 0; s < mapSources.length; s++) { for (var k in mapSources[s]) { if (Object.prototype.hasOwnProperty.call(mapSources[s], k)) keys[k] = true; } }
    if (node.popupAliases) {
      for (var ak in node.popupAliases) {
        if (Object.prototype.hasOwnProperty.call(node.popupAliases, ak) && node.popupAliases[ak]) {
          aliases[ak] = node.popupAliases[ak];
          keys[ak] = true;
        }
      }
    }
    var selected = node.popupFields || [], popupEnabled = node.popupEnabled !== false && selected.length > 0;
    layer.set('interactive', popupEnabled);
    var orderedAliases = {}, orderedLabels = {}, orderedImages = {};
    for (var idx = 0; idx < selected.length; idx++) {
      var selKey = selected[idx];
      orderedAliases[selKey] = aliases[selKey] || selKey;
      var lblMode = baseLabels[selKey];
      if (!lblMode || lblMode === 'hidden field') lblMode = 'inline label - always visible';
      orderedLabels[selKey] = popupEnabled ? lblMode : 'hidden field';
      var imgMode = baseImages[selKey];
      if (!imgMode || imgMode === 'Hidden') imgMode = 'TextEdit';
      orderedImages[selKey] = popupEnabled ? imgMode : 'Hidden';
    }
    for (var fieldName in keys) {
      if (!Object.prototype.hasOwnProperty.call(keys, fieldName)) continue;
      if (selected.indexOf(fieldName) < 0) {
