  function hookBasemapGrayscaleEvents() {
    if (!window.map || typeof window.map.getLayers !== 'function') return;
    var allLeaves = [];
    collectMapLeafLayers(window.map.getLayers(), allLeaves);
    var basemaps = [];
    for (var i = 0; i < allLeaves.length; i++) {
      if (isBasemapLayer(allLeaves[i])) basemaps.push(allLeaves[i]);
    }
    if (basemaps.length === 0 && window.ol && window.ol.layer && window.ol.layer.Tile && window.ol.source && window.ol.source.OSM) {
      if (!window._q2wFallbackGrayscaleLayer) {
